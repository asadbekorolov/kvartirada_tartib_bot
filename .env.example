# Telegram Bot Token (BotFather'dan olingan token)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_example

# Ma'lumotlar bazasi ulanish manzili (SQLite Async)
DATABASE_URL=sqlite+aiosqlite:///kvartira.db

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent

# Kvartira nomi
APARTMENT_NAME=Bizning Kvartira (7-dom)

# Rotatsiya boshlang'ich sanasi (YYYY-MM-DD)
ROTATION_BASE_DATE=2026-01-01

# Umumiy guruh chat ID (agar eslatmalar guruhga jo'natilishi kerak bo'lsa, masalan: -1001234567890)
GROUP_CHAT_ID=

# Jarima miqdori (so'mda)
DAILY_FINE_AMOUNT=15000
